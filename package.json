{
  "name": "scut-racing-telemetry",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc --noEmit -p config/frontend/tsconfig.json && vite build --config config/frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p config/frontend/tsconfig.json",
    "lint": "eslint src config/frontend --config config/frontend/eslint.config.js --max-warnings 0",
    "test": "vitest run --config config/frontend/vite.config.ts",
    "tauri": "tauri",
    "dev:web": "vite --config config/frontend/vite.config.ts",
    "check": "pwsh -NoProfile -File tests/tooling/check.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "postcss": "8.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "dockview": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.0",
    "uplot": "^1.6.30",
    "zustand": "^5.0.0"
  },
  "type": "module"
}
