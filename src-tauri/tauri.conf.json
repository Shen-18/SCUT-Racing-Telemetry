{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCUT Racing Telemetry",
  "version": "1.0.0",
  "identifier": "cn.scutracing.telemetry",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../target/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "SCUT Racing Telemetry",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["../Data/SCUTRacing.ico"],
    "windows": {"webviewInstallMode": {"type": "embedBootstrapper"}}
  }
}
