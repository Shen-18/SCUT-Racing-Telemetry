{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCUT Racing Telemetry",
  "version": "1.0.1",
  "identifier": "cn.scutracing.telemetry",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../target/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "SCUT Racing Telemetry",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "../Data/SCUTRacing.ico"
    ],
    "resources": {
      "../TestMatLabXRK/DLL-2022/MatLabXRK-2022-64-ReleaseU.dll": "aim/MatLabXRK-2022-64-ReleaseU.dll",
      "../TestMatLabXRK/64/libiconv-2.dll": "aim/libiconv-2.dll",
      "../TestMatLabXRK/64/libxml2-2.dll": "aim/libxml2-2.dll",
      "../TestMatLabXRK/64/libz.dll": "aim/libz.dll",
      "../TestMatLabXRK/64/pthreadVC2_x64.dll": "aim/pthreadVC2_x64.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERUJDRjRBMUNCNEE2MkMKUldRc3ByUWNTcy9yN2ZMQjdyNHFWKzRYSzBvUUt2YXRXcXRmcTlGMHVPWEZpM1lKd1o2MVNjbHYK",
      "endpoints": [
        "http://8.134.196.199:8787/api/v1/updates/latest"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
